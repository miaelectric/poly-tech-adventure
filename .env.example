# 환경 변수 예시 — 실제 값은 커밋하지 말고 아래 명령으로 받으세요.
# (먼저 `vercel login`, `vercel link` 필요)
#
#   npm run env:pull       → .env.local(개발 DB) + .env.prod.local(운영 DB)
#   npm run db:schema      → 개발 DB에 db/schema.sql 적용
#   npm run db:schema:prod → 운영 DB에 db/schema.sql 적용
#   npm run dev
#
# DATABASE_URL이 없으면 개발 모드에서는 메모리 저장소(재시작 시 초기화)로 동작하고,
# 운영 모드에서는 랭킹 API가 503을 반환합니다.

# Neon Postgres 연결 문자열 (Vercel Marketplace Neon 연동 시 자동 등록)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
